{
  "name": "the-retro-shelf",
  "productName": "The Retro Shelf",
  "version": "0.3.0",
  "description": "Your retro game collection as boxes on a shelf. Emulators built in, games not included.",
  "author": "Colin Galbraith",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/colingalbraith/the-retro-shelf",
  "repository": {
    "type": "git",
    "url": "https://github.com/colingalbraith/the-retro-shelf.git"
  },
  "bugs": {
    "url": "https://github.com/colingalbraith/the-retro-shelf/issues"
  },
  "keywords": [
    "retro",
    "emulator",
    "frontend",
    "launcher",
    "retroarch",
    "libretro",
    "game-library",
    "electron"
  ],
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "fetch:mac": "node scripts/fetch-emulators.mjs mac",
    "fetch:win": "node scripts/fetch-emulators.mjs win",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.colingalbraith.theretroshelf",
    "productName": "The Retro Shelf",
    "copyright": "The Retro Shelf contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/${os}",
        "to": "emulators"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "colingalbraith",
        "repo": "the-retro-shelf",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "The-Retro-Shelf-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.games",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSHumanReadableCopyright": "Emulators: RetroArch and libretro cores (see Licenses)"
      }
    },
    "dmg": {
      "title": "The Retro Shelf"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "The Retro Shelf",
      "artifactName": "The-Retro-Shelf-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
